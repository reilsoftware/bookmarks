# Copy to .env and edit. docker compose reads .env automatically.

# Public name that points at your router; Caddy gets a Let's Encrypt certificate for it.
DOMAIN=bookmarks.example.com

# Port for use at home (LAN and Tailscale), no login. Do not forward it on your router.
LAN_PORT=1234

# Ports Caddy listens on. Forward router ports 80 and 443 to these.
HTTP_PORT=8880
HTTPS_PORT=8443
